# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeplix?schema=public"

# NextAuth
# NEXTAUTH_URL deve ser a URL pública usada para acessar a aplicação (ex.: http://192.168.1.113:3100 ou https://meeplix.seudominio.com)
NEXTAUTH_SECRET="gere-uma-chave-segura-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin User (para seed inicial)
ADMIN_EMAIL="admin@meeplix.local"
ADMIN_PASSWORD="senha_segura_aqui"
ADMIN_NAME="Administrador"

# Storage
STORAGE_PATH="/app/storage"
MAX_FILE_SIZE="104857600"

# App
NEXT_PUBLIC_APP_NAME="Meeplix"
NEXT_PUBLIC_APP_URL="http://localhost:3000" # mesma URL pública de NEXTAUTH_URL

# Integrações
BGG_API_TOKEN=""