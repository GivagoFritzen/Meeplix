# Base image
FROM node:22 AS base

# Install dependencies
FROM base AS deps
WORKDIR /app

COPY package.json package-lock.json* ./
COPY prisma ./prisma/

RUN npm ci

# One-shot migration/seed image (used by the `migrate` compose service)
FROM deps AS migrator
WORKDIR /app

COPY prisma ./prisma
COPY lib ./lib
COPY tsconfig.json ./

CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx prisma/seed.ts"]

# Build application
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create application user
RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs \
       --shell /bin/bash --create-home nextjs

# Copy Next.js standalone build
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Copy static assets generated by Next.js
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy public assets, including logo.svg
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Create persistent storage directory with correct permissions
RUN mkdir -p /app/storage \
    && chown nextjs:nodejs /app/storage

# Run application as non-root user
USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
