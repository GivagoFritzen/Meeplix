# Database (banco exclusivo de testes - NUNCA usar para desenvolvimento/produção)
DATABASE_URL="postgresql://meeplix_test:meeplix_test@localhost:5433/meeplix_test?schema=public"

# NextAuth
NEXTAUTH_SECRET="test-secret-do-not-use-in-production-1234567890"
NEXTAUTH_URL="http://localhost:3000"

# Admin User (para seed inicial nos testes)
ADMIN_EMAIL="admin-test@meeplix.local"
ADMIN_PASSWORD="admin123"

# Storage (diretório temporário isolado para testes)
STORAGE_PATH="/tmp/meeplix-test-storage"
MAX_FILE_SIZE="104857600"

# App
NEXT_PUBLIC_APP_NAME="Meeplix Test"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Integrações (somente para testes com mock)
BGG_API_TOKEN="test-bgg-token"
